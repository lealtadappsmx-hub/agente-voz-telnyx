# No configure GEMINI_API_KEY ni TELNYX_API_KEY aquí. Cada llamada exige las
# claves cifradas del negocio resuelto por el panel; no existe respaldo global.

# Observación del panel: desactivada por defecto y sin efecto en la llamada.
USE_PANEL_CONFIG=false
PANEL_BASE_URL=https://panelvoz.lealtadapps.com
VOICE_SERVICE_SHARED_SECRET=
# Mantener false en producción: si el panel no resuelve al agente, no iniciar
# una llamada con configuración fija de respaldo.
PANEL_CONFIG_FALLBACK_ENABLED=false
PANEL_CONFIG_TIMEOUT_SECONDS=3
